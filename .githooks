@'
#!/usr/bin/env bash
staged_files=$(git diff --cached --name-only)
for file in $staged_files; do
    if [ -f "$file" ]; then
        if git show ":$file" | grep -qiE "password\s*[:=]|api[-_]?key\s*[:=]"; then
            echo ""
            echo "[CANH BAO BAO MAT] Phat hien mat khau/API key trong file: $file"
            echo "Lenh commit bi huy bo ngay lap tuc!"
            echo ""
            exit 1
        fi
    fi
done
exit 0
'@ | Set-Content -Path .githooks\pre-commit -NoNewline

